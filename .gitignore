# ================================
# Fast N Fresh - Root Git Ignore
# ================================

# ---------- Node / Backend ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Environment / Secrets ----------
.env
.env.*

# Firebase Admin / Server Credentials
**/firebase-service-account.json
**/firebase-adminsdk*.json
**/service-account*.json

# Android signing credentials
**/key.properties
**/*.jks
**/*.keystore
**/*.p12

# ---------- Backend Runtime ----------
backend/uploads/
backend/logs/
backend/tmp/
backend/temp/
backend/*.log

# ---------- Flutter ----------
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub/
.pub-cache/

**/build/
**/dist/

# Flutter generated files
flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# ---------- Android Generated ----------
**/.gradle/
**/local.properties
**/captures/

# Android generated build directories
android/app/debug/
android/app/profile/
android/app/release/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ---------- OS ----------
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*~

# ---------- Logs ----------
*.log

# ---------- Test / Coverage ----------
coverage/

# ---------- Misc ----------
*.class
!backend/.env.example
